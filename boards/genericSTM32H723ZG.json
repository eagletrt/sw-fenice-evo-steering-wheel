{
  "build": {
    "core": "stm32",
    "cpu": "cortex-m7",
    "extra_flags": "-DSTM32H7 -DSTM32H7xx -DSTM32H723xx",
    "f_cpu": "550000000L",
    "mcu": "stm32h723zgt6",
    "product_line": "STM32H723xx"
  },
  "debug": {
    "default_tools": [
      "stlink"
    ],
    "jlink_device": "STM32H723ZG",
    "openocd_target": "stm32h7x",
    "svd_path": "STM32H723.svd"
  },
  "frameworks": [
    "cmsis",
    "stm32cube"
  ],
  "name": "Custom STM32H723ZG (Cortex-M7, 1M flash, 564K RAM)",
  "upload": {
    "maximum_ram_size": 327680,
    "maximum_size": 1048576,
    "protocol": "stlink",
    "protocols": [
      "stlink",
      "cmsis-dap",
      "jlink",
      "blackmagic"
    ]
  },
  "url": "https://www.st.com/en/microcontrollers-microprocessors/stm32h723zg.html",
  "vendor": "ST"
}
